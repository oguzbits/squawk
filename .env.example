# Local development only. All AWS calls go to Floci; credentials are dummy values.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Floci RDS proxy port (see docker-compose.yml)
DATABASE_URL=postgres://squawk:squawk-local@localhost:7001/squawk

PORT=3000
LOG_LEVEL=info
RATE_LIMIT_MAX=100

S3_BUCKET=squawk-attachments
# Origin of the web app, allowed by the bucket CORS rules
WEB_ORIGIN=http://localhost:5173

# Redis (ElastiCache in Floci). Optional: without it the dashboard is computed on every request.
REDIS_URL=redis://localhost:6379
