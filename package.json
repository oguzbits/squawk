{
  "name": "squawk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "env:up": "test -f .env || cp .env.example .env; pnpm --filter @squawk/importer build && docker compose up -d && node --env-file=.env scripts/bootstrap-local.ts && pnpm --filter @squawk/api db:migrate && pnpm --filter @squawk/api db:seed",
    "env:down": "docker ps -aq --filter name=floci-aws | xargs -r docker rm -f; docker compose down",
    "dev": "pnpm --parallel --filter @squawk/api --filter @squawk/web dev",
    "test": "pnpm -r test",
    "typecheck": "tsc -p scripts && pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "load:seed": "node --env-file=.env scripts/load-seed.ts",
    "load:clean": "node --env-file=.env scripts/load-seed.ts --clean",
    "load:measure": "node --env-file=.env scripts/load-dashboard.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-elasticache": "3.1152.0",
    "@aws-sdk/client-lambda": "3.1152.0",
    "@aws-sdk/client-rds": "3.1152.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/client-sqs": "3.1152.0",
    "@eslint/js": "10.0.1",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "autocannon": "^8.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
